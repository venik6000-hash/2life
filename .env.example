# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env

# База данных PostgreSQL
POSTGRES_PASSWORD=your-secure-db-password-here

# JWT-секрет — минимум 64 случайных символа
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-jwt-secret-change-this

# Messenger encryption secret — minimum 32 characters
MESSENGER_ENCRYPTION_SECRET=change-this-to-a-random-64-character-secret-before-production

# Web Push / PWA notifications
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Учётные данные первого администратора
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-here

# Порт для публикации фронтенда (опционально, по умолчанию 80)
# PORT=80

# WHOOP OAuth 2.0 (Pulse Wave / «Моя волна» feature)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
