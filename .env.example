# Скопируйте этот файл в .env и заполните значения

# Пароль PostgreSQL (придумайте любой)
POSTGRES_PASSWORD=your-secure-db-password

# Секрет для JWT токенов (длинная случайная строка)
JWT_SECRET=your-very-long-random-secret-change-this

# Первый admin аккаунт (создаётся автоматически при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# Порт, на котором будет доступно приложение
PORT=80
